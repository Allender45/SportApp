generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COACH
  ATHLETE
  ADMIN
}

enum ResultStatus {
  DONE
  FAILED
}

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  lastName     String   @default("")
  firstName    String   @default("")
  middleName   String?
  role         Role     @default(ATHLETE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coachProfile   Athlete[] @relation("CoachAthletes")
  athleteProfile Athlete?  @relation("AthleteUser")

  chatParticipations       ChatParticipant[]
  chatMessages             ChatMessage[]      @relation("ChatMessageSender")
  createdChatConversations ChatConversation[] @relation("CreatedChatConversations")
}

model Athlete {
  id         String    @id @default(uuid())
  userId     String    @unique
  user       User      @relation("AthleteUser", fields: [userId], references: [id], onDelete: Cascade)
  coachId    String?
  coach      User?     @relation("CoachAthletes", fields: [coachId], references: [id])
  workouts   Workout[]
  coachNotes String?

  aiConversation AiConversation?
}

model Workout {
  id        String     @id @default(uuid())
  athleteId String
  athlete   Athlete    @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  number    Int
  title     String?
  createdAt DateTime   @default(now())
  exercises Exercise[]

  @@unique([athleteId, number])
}

model Exercise {
  id          String   @id @default(uuid())
  workoutId   String
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  order       Int
  name        String
  sets        Int
  reps        Int
  weight      Float    @default(0)
  trainerNote String?
  results     Result[]
}

model Result {
  id             String       @id @default(uuid())
  exerciseId     String
  exercise       Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  status         ResultStatus
  athleteComment String?
  completedAt    DateTime     @default(now())
}

model ExerciseTemplate {
  id       String  @id @default(uuid())
  name     String  @unique
  imageUrl String?
}

enum AiMessageRole {
  USER
  ASSISTANT
}

model AiConversation {
  id        String  @id @default(cuid())
  athleteId String  @unique
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  // Краткое содержание всего предыдущего общения.
  summary String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role      AiMessageRole
  content   String        @db.Text
  createdAt DateTime      @default(now())

  @@index([conversationId, createdAt])
}

enum ChatConversationType {
  DIRECT
  GROUP
}

model ChatConversation {
  id   String               @id @default(cuid())
  type ChatConversationType

  // Название используется для групповых чатов.
  title String?

  /**
   * Ключ личной беседы состоит из двух отсортированных userId.
   * Он не позволяет создать два разных диалога для одной пары.
   * Для групповых чатов поле равно null.
   */
  directKey String? @unique

  createdById String?
  createdBy   User?   @relation("CreatedChatConversations", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([updatedAt])
}

model ChatParticipant {
  id             String @id @default(cuid())
  conversationId String
  userId         String

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String @id @default(cuid())
  conversationId String
  senderId       String

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  content String @db.Text

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([conversationId, createdAt])
  @@index([senderId])
}
